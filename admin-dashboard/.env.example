NEXT_PUBLIC_CONVEX_URL=https://ideal-poodle-813.convex.cloud
CONVEX_URL=https://ideal-poodle-813.convex.cloud

# ─── Admin login throttling (names only; set real values in the host's secret store) ───
# Must equal LOGIN_PROXY_SECRET on the Convex deployment (>= 16 chars). Lets Convex know the login call
# comes from this server, so it never locks every administrator out through this server's shared IP.
LOGIN_PROXY_SECRET=
# Optional: the ONE header your proxy sets with the real browser IP and that clients cannot spoof
# (e.g. cf-connecting-ip behind Cloudflare). Leave empty unless that is guaranteed.
TRUSTED_CLIENT_IP_HEADER=

# ═══════════════════════════════════════════════════════════════════════
# VEKTOLUX — Production Telecom & Payment Gateway Environment Slots
# ═══════════════════════════════════════════════════════════════════════
# These slots allow dropping in live API keys as soon as merchant
# onboarding with Orange, Africell, or an aggregator finishes.
# Configure these in Convex Dashboard: https://dashboard.convex.dev/t/lucky-f11c9/vektolux/ideal-poodle-813/settings/environment-variables
# ═══════════════════════════════════════════════════════════════════════

# ─── CONVEX CLOUD BACKEND ─────────────────────────────────────────────
CONVEX_DEPLOYMENT="dev:ideal-poodle-813"
CONVEX_URL="https://ideal-poodle-813.convex.cloud"
CONVEX_SITE_URL="https://ideal-poodle-813.convex.site"

# ─── OPTION A: DIRECT ORANGE MONEY SIERRA LEONE ───────────────────────
# Obtained from Orange Developer Partner Portal (Sierra Leone)
ORANGE_MONEY_CLIENT_ID=""
ORANGE_MONEY_CLIENT_SECRET=""
ORANGE_MONEY_MERCHANT_KEY=""
ORANGE_MONEY_WEBHOOK_SECRET=""
ORANGE_MONEY_BASE_URL="https://api.orange.com" # Sandbox: https://api.orange.com/orange-money-webpay/dev/v1

# ─── OPTION B: DIRECT AFRICELL AFRIMONEY SIERRA LEONE ─────────────────
# Obtained from Africell Sierra Leone Merchant Services
AFRIMONEY_MERCHANT_ID=""
AFRIMONEY_API_KEY=""
AFRIMONEY_API_SECRET=""
AFRIMONEY_WEBHOOK_SECRET=""

# ─── MONIME SIERRA LEONE (Orange Money / Afrimoney / QMoney) ─
# MoniMe Merchant Workspace and Gateway Credentials
MONIME_SPACE_ID=""
MONIME_ACCESS_TOKEN=""
MONIME_WEBHOOK_SECRET=""
# OPTIONAL, migration only: the legacy Monime webhook's secret. Leave unset unless the legacy webhook
# must keep being accepted; REMOVE it once the legacy webhook is retired.
# MONIME_WEBHOOK_SECRET_OLD=""
MONIME_API_BASE_URL="https://api.monime.io/v1"

# ─── EMAIL (Resend) ───────────────────────────────────────────────────
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# ─── IDENTITY VERIFICATION PROVIDER WEBHOOK (optional) ────────────────
EIDV_WEBHOOK_SECRET=""

# ─── ON-CHAIN AUDIT LEDGER (optional, not configured) ─────────────────
BLOCKCHAIN_RPC_URL=""
AUDIT_LEDGER_CONTRACT_ADDRESS=""
RELAYER_PRIVATE_KEY=""

# NOTE: Backend secrets are set in the Convex dashboard (link at the top), NEVER in a committed file.
# Locally, .env.local only needs CONVEX_DEPLOYMENT / CONVEX_URL / CONVEX_SITE_URL (see README).
